# Engineering smoke only: 8 ORCA successes, 2 IL epochs, 4 RL episodes.
# Physical settings and original MC targets are inherited unchanged.
[env]
time_limit = 50
time_step = 0.25
val_size = 100
test_size = 500
randomize_attributes = false

[reward]
success_reward = 1.0
collision_penalty = -0.5
timeout_penalty = -0.5
progress_reward = 0.0
time_penalty = 0.0
stand_penalty = 0.0
discomfort_dist = 0.2
discomfort_penalty_factor = 0.5

[sim]
train_val_sim = circle_crossing
test_sim = circle_crossing
square_width = 10
circle_radius = 4
human_num = 5

[humans]
visible = true
policy = orca
radius = 0.3
v_pref = 1.0
sensor = coordinates

[robot]
visible = false
policy = none
radius = 0.3
v_pref = 1.0
sensor = coordinates
success_radius = 0.25

[orca]
neighbor_dist = 10.0
max_neighbors = 10
time_horizon = 5.0
time_horizon_obst = 5.0
safety_space = 0.10

[action_space]
kinematics = holonomic

[policy]
n_speeds = 5
n_headings = 16
v_min = 0.05
v_max = 1.0
sampling = exponential
include_stop = false
stop_eps = 0.05

[temporal]
t = 24
num_actions = 80
use_actions = true

[mamba]
d_model = 256
n_layers = 4
d_state = 64
d_conv = 4
expand = 2
dropout = 0.03
n_blocks = 3
temporal_backbone = bayes

[head]
use_goal_prior_train = false
use_goal_prior_eval = false

[eval_envs]
baseline_circle = circle:4.0:5
baseline_square = square:10.0:10
dense_circle = circle:4.0:10
dense_square = square:10.0:20
large_circle = circle:6.0:12
large_square = square:14.0:20

[eval_protocol]
episodes_per_env = 50
human_policies = orca,sfm
robot_visible = false
time_limit = 25
time_step = 0.25
success_radius = 0.25
discomfort_threshold = 0.2
safety_margin = 0.2
risk_lambda = 0.8
action_smoothing = 0.3

[train]
algo = sarl
train_episodes = 4
eval_every = 4
eval_episodes = 2
save_every = 4
batch_size = 16
learning_rate = 1e-5
gamma = 0.99
updates_per_ep = 2
il_epochs = 2
il_batch_size = 16
il_learning_rate = 1e-4
replay_warmup = 64
seed = 42
plot_every = 1000

[buffer]
capacity = 200000
seq_len = 24

[imitation_learning]
post_il_eval_episodes = 2
success_target = 8
max_il_prefill = 8
teacher_safety_space = 0.25
teacher_neighbor_dist = 6.0
teacher_max_neighbors = 15
teacher_time_horizon = 5.0
teacher_time_horizon_obst = 5.0
max_prefill_episodes = 32
prefill_batch_episodes = 8
force_online = true

[sarl]
epsilon_start = 0.3
epsilon_end = 0.05
epsilon_decay_episodes = 1500
value_lr = 1e-5

[doubleq]
learning_rate = 1e-5
backbone_learning_rate = 1e-6
freeze_backbone_episodes = 1000
epsilon_start = 0.3
epsilon_end = 0.05
epsilon_decay_episodes = 1500
td_weight = 0.25
bc_weight_start = 1.0
bc_weight_end = 0.5
bc_weight_decay_episodes = 3000
bc_temperature = 1.0
q_target_min = -0.5
q_target_max = 1.0
eval_every = 250
eval_episodes = 50
collapse_ratio = 0.60
collapse_patience = 2
early_stop_patience = 6
min_evals_before_stop = 3
